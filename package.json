{
  "name": "ap3x-solana",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "diag": "pnpm --filter @ap3x/solana-connectivity diag",
    "capture:spl": "node --import tsx tests/helpers/capture/spl-capture.ts",
    "capture:metaplex": "node --import tsx tests/helpers/capture/metaplex-capture.ts",
    "capture:cold-start-tx-history": "node --import tsx tests/helpers/capture/capture-cold-start-tx-history.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@ap3x/solana-connectivity": "workspace:*",
    "@ap3x/solana-metaplex": "workspace:*",
    "@ap3x/solana-spl": "workspace:*",
    "@changesets/cli": "^2.27.7",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.10.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "msw": "^2.13.4",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^2.1.0"
  }
}
