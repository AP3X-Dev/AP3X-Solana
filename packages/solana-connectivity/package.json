{
  "name": "@ap3x/solana-connectivity",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ap3x-solana-diag": "./dist/diag/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "diag": "tsx src/diag/cli.ts"
  },
  "dependencies": {
    "@ap3x/solana-core": "workspace:*",
    "@grpc/grpc-js": "^1.11.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
