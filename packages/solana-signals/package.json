{
  "name": "@ap3x/solana-signals",
  "version": "0.4.0",
  "description": "Solana signal sources (Geyser, historical, fixture), queue and signal bus.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AP3X-Dev/AP3X-Solana.git",
    "directory": "packages/solana-signals"
  },
  "homepage": "https://github.com/AP3X-Dev/AP3X-Solana/tree/main/packages/solana-signals#readme",
  "bugs": {
    "url": "https://github.com/AP3X-Dev/AP3X-Solana/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ap3x/solana-core": "workspace:*",
    "@ap3x/solana-connectivity": "workspace:*",
    "@ap3x/solana-events": "workspace:*",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
