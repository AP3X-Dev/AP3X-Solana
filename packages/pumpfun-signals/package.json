{
  "name": "@ap3x/pumpfun-signals",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AP3X-Dev/AP3X-Solana.git",
    "directory": "packages/pumpfun-signals"
  },
  "homepage": "https://github.com/AP3X-Dev/AP3X-Solana/tree/main/packages/pumpfun-signals#readme",
  "bugs": {
    "url": "https://github.com/AP3X-Dev/AP3X-Solana/issues"
  },
  "private": false,
  "description": "Interim sqlite-backed pump.fun signals API. Stable interface; storage backend is replaced in a later release. Consumers code against the interface, not the storage.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ap3x/solana-core": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-sqlite3": ">=9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
