{
  "name": "@ap3x/pumpfun-events",
  "version": "0.1.0",
  "description": "Decoders for pump.fun bonding-curve and PumpSwap events, generated from the published program IDLs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AP3X-Dev/AP3X-Solana.git",
    "directory": "packages/pumpfun-events"
  },
  "homepage": "https://github.com/AP3X-Dev/AP3X-Solana/tree/main/packages/pumpfun-events#readme",
  "bugs": {
    "url": "https://github.com/AP3X-Dev/AP3X-Solana/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "diag": "tsx scripts/diag.ts",
    "gen:idl": "node scripts/gen-idl-schema.mjs"
  },
  "dependencies": {
    "@ap3x/solana-core": "workspace:*",
    "@ap3x/solana-events": "workspace:*",
    "@ap3x/solana-tx": "workspace:*"
  },
  "devDependencies": {
    "@ap3x/solana-connectivity": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
